{
  "name": "@wp-harness/wp-mcp-server",
  "version": "0.1.0",
  "description": "WordPress MCP Server for autonomous block theme development, PHP syntax checking, ephemeral WP Playground verification, and artifact export",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "bin": {
    "wp-mcp-server": "lib/index.js"
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist && cp -r lib/types/* dist/",
    "watch": "tsc --watch",
    "start": "node lib/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
