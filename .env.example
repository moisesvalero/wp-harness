# ==============================================================================
# WP-HARNESS: UNIVERSAL MULTI-MODEL CONFIGURATION
# ==============================================================================
# WP-Harness dynamically detects and routes requests to your chosen provider.
# Fill in ANY ONE of the providers below, or specify WP_HARNESS_PROVIDER explicitly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEEPSEEK DIRECT
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Optional base URL override (defaults to official https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# 2. OPENROUTER UNIVERSAL (Access any model: DeepSeek R1, Claude, GPT-4o, Llama)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Optional base URL override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 3. ANTHROPIC DIRECT (Claude 3.5 Sonnet / Claude 3.7 Sonnet)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# Optional base URL override
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------------------------------------
# 4. OPENAI DIRECT (GPT-4o, o3-mini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key-here
# Optional base URL override
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. LOCAL OLLAMA / vLLM / SGLang (Zero-Cost Local Inference)
# ------------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:32b
# OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------------------
# ROUTING CONTROLS (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Force a specific provider: 'deepseek' | 'openrouter' | 'anthropic' | 'openai' | 'ollama'
# WP_HARNESS_PROVIDER=openrouter
# Force a specific model ID:
# WP_HARNESS_MODEL=deepseek/deepseek-r1

# ------------------------------------------------------------------------------
# WORDPRESS PLAYGROUND & HARNESS DEFAULTS
# ------------------------------------------------------------------------------
WP_HARNESS_WORKSPACE=./workspace
WP_PLAYGROUND_PORT=9440
WP_HARNESS_LOG_LEVEL=info
