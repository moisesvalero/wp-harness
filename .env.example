# ==============================================================================
# WP-HARNESS: UNIVERSAL MULTI-MODEL CONFIGURATION
# ==============================================================================
# WP-Harness dynamically detects and routes requests to your chosen provider.
# Fill in ANY ONE of the providers below, or specify WP_HARNESS_PROVIDER explicitly.
# Run `npx wp-model-route --list` to inspect all supported engines and models.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (Gemini 2.5 Pro / Flash, 1M+ context, Multimodal)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model override (defaults to gemini-2.5-pro):
# GEMINI_MODEL=gemini-2.5-flash
# Optional base URL override (defaults to https://generativelanguage.googleapis.com/v1beta/openai/):
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 2. MISTRAL AI / CODESTRAL (Specialized Code, FSE Block Themes, Multilingual)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key-here
# Optional model override (defaults to codestral-latest):
# MISTRAL_MODEL=mistral-large-latest
# Optional base URL override (defaults to https://api.mistral.ai/v1):
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ------------------------------------------------------------------------------
# 3. COHERE COMMAND (Command R+, Enterprise Reasoning & Agentic Planning)
# ------------------------------------------------------------------------------
COHERE_API_KEY=your-cohere-api-key-here
# Optional model override (defaults to command-r-plus-08-2024):
# COHERE_MODEL=command-r-plus
# Optional base URL override (defaults to https://api.cohere.com/compatibility/v1):
# COHERE_BASE_URL=https://api.cohere.com/compatibility/v1

# ------------------------------------------------------------------------------
# 4. GROQ LPU (Ultra-Fast Inference, Llama 3.3 70B, DeepSeek R1 Distill)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-api-key-here
# Optional model override (defaults to llama-3.3-70b-versatile):
# GROQ_MODEL=deepseek-r1-distill-llama-70b
# Optional base URL override (defaults to https://api.groq.com/openai/v1):
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 5. ANTHROPIC CLAUDE (Claude 3.7 Sonnet Hybrid Thinking & Coding)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# Optional model override (defaults to claude-3-7-sonnet-20250219):
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional base URL override (defaults to https://api.anthropic.com):
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------------------------------------
# 6. OPENAI (GPT-4o, o3-mini, o1)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key-here
# Optional model override (defaults to gpt-4o):
# OPENAI_MODEL=o3-mini
# Optional base URL override (defaults to https://api.openai.com/v1):
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 7. OPENROUTER UNIVERSAL GATEWAY (200+ models, Dynamic Fallbacks)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Optional model override (defaults to deepseek/deepseek-r1):
# OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
# Optional base URL override (defaults to https://openrouter.ai/api/v1):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 8. TOGETHER AI (Serverless DeepSeek V3/R1, Qwen 2.5 Coder, Llama 3.3)
# ------------------------------------------------------------------------------
TOGETHER_API_KEY=your-together-api-key-here
# Optional model override (defaults to deepseek-ai/DeepSeek-V3):
# TOGETHER_MODEL=deepseek-ai/DeepSeek-R1
# Optional base URL override (defaults to https://api.together.xyz/v1):
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# ------------------------------------------------------------------------------
# 9. xAI GROK (Grok 2, Grok Vision)
# ------------------------------------------------------------------------------
XAI_API_KEY=xai-your-xai-key-here
# Optional model override (defaults to grok-2-1212):
# XAI_MODEL=grok-beta
# Optional base URL override (defaults to https://api.x.ai/v1):
# XAI_BASE_URL=https://api.x.ai/v1

# ------------------------------------------------------------------------------
# 10. CEREBRAS (Wafer-Scale Ultra-Throughput Inference)
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=csk-your-cerebras-key-here
# Optional model override (defaults to llama-3.3-70b):
# CEREBRAS_MODEL=llama-3.1-8b
# Optional base URL override (defaults to https://api.cerebras.ai/v1):
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ------------------------------------------------------------------------------
# 11. FIREWORKS AI (High-Throughput Open Weights)
# ------------------------------------------------------------------------------
FIREWORKS_API_KEY=fw_your-fireworks-key-here
# Optional model override (defaults to accounts/fireworks/models/deepseek-v3):
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-r1
# Optional base URL override (defaults to https://api.fireworks.ai/inference/v1):
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ------------------------------------------------------------------------------
# 12. PERPLEXITY AI (Sonar Online Grounded Models)
# ------------------------------------------------------------------------------
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here
# Optional model override (defaults to sonar-pro):
# PERPLEXITY_MODEL=sonar-reasoning-pro
# Optional base URL override (defaults to https://api.perplexity.ai):
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ------------------------------------------------------------------------------
# 13. DEEPINFRA (Serverless DeepSeek R1/V3 & Qwen Hosting)
# ------------------------------------------------------------------------------
DEEPINFRA_API_KEY=your-deepinfra-key-here
# Optional model override (defaults to deepseek-ai/DeepSeek-V3):
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-R1
# Optional base URL override (defaults to https://api.deepinfra.com/v1/openai):
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ------------------------------------------------------------------------------
# 14. LOCAL OLLAMA / vLLM (Zero-Cost Local Private Inference)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------------------
# 15. DEEPSEEK OFFICIAL DIRECT (Official DeepSeek V3 / R1)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Optional model override (defaults to deepseek-chat):
# DEEPSEEK_MODEL=deepseek-reasoner
# Optional base URL override (defaults to https://api.deepseek.com):
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# ROUTING CONTROLS (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Explicit provider choice:
# 'gemini' | 'mistral' | 'cohere' | 'groq' | 'anthropic' | 'openai' |
# 'openrouter' | 'together' | 'xai' | 'cerebras' | 'fireworks' |
# 'perplexity' | 'deepinfra' | 'ollama' | 'deepseek'
# WP_HARNESS_PROVIDER=gemini
# Force specific model name:
# WP_HARNESS_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# WORDPRESS PLAYGROUND & HARNESS DEFAULTS
# ------------------------------------------------------------------------------
WP_HARNESS_WORKSPACE=./workspace
WP_PLAYGROUND_PORT=9440
WP_HARNESS_LOG_LEVEL=info
